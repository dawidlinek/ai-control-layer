    "Verdict": {
      "additionalProperties": false,
      "properties": {
        "control_id": {
          "title": "Control Id",
          "type": "string"
        },
        "control_type": {
          "title": "Control Type",
          "type": "string"
        },
        "phase": {
          "$ref": "#/$defs/Phase"
        },
        "cost_tier": {
          "$ref": "#/$defs/CostTier"
        },
        "action": {
          "$ref": "#/$defs/Action",
          "default": "allow"
        },
        "final": {
          "default": false,
          "description": "Deterministic denial: cannot be relaxed by any later stage or score.",
          "title": "Final",
          "type": "boolean"
        },
        "score": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Score"
        },
        "rule_ids": {
          "items": {
            "description": "Rule identifier (control id, or control id + sub-rule, or signature id).",
            "pattern": "^[A-Z][A-Z0-9]*(-[A-Z0-9_.]+)+$",
            "type": "string"
          },
          "title": "Rule Ids",
          "type": "array"
        },
        "findings": {
          "items": {
            "$ref": "#/$defs/Finding"
          },
          "title": "Findings",
          "type": "array"
        },
        "risk_factors": {
          "items": {
            "$ref": "#/$defs/RiskFactor"
          },
          "title": "Risk Factors",
          "type": "array"
        },
        "labels": {
          "anyOf": [
            {
              "$ref": "#/$defs/LabelUpdate"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "data_class": {
          "anyOf": [
            {
              "$ref": "#/$defs/DataClass"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Sensitivity class detected by this control."
        },
        "taxonomy": {
          "$ref": "#/$defs/Taxonomy"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Human-readable explanation. Must not contain raw values.",
          "title": "Reason"
        },
        "status": {
          "$ref": "#/$defs/VerdictStatus",
          "default": "ok"
        },
        "fail_mode_applied": {
          "anyOf": [
            {
              "$ref": "#/$defs/FailMode"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "latency_ms": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Latency Ms",
          "type": "number"
        }
      },
      "required": [
        "control_id",
        "control_type",
        "phase",
        "cost_tier"
      ],
      "title": "Verdict",
      "type": "object"
    },
    "VerdictStatus": {
      "enum": [
        "ok",
        "cached",
        "timeout",
        "error",
        "skipped"
      ],
      "title": "VerdictStatus",
      "type": "string"
