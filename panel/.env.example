# Rogatka Dashboard environment. Copy to .env.local for local development.

# --- Mock mode: run with no gateway and no Keycloak (MSW answers /admin/v1/*) ---
# NEXT_PUBLIC_API_MOCKING=enabled
# ROGATKA_AUTH=dev                 # default when mocking is enabled; "keycloak" otherwise

# --- Real mode ---
ROGATKA_GATEWAY_URL=http://localhost:8000
AUTH_SECRET=                       # openssl rand -base64 32
AUTH_URL=http://localhost:3000
AUTH_KEYCLOAK_ID=panel
AUTH_KEYCLOAK_SECRET=              # KC_PANEL_SECRET from the repo .env
AUTH_KEYCLOAK_ISSUER=http://localhost:8180/realms/acl
