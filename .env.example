# AI Control Layer – environment. Copy to .env (or run `make env`, which also generates secrets).
# NEVER commit .env. Empty secret values below are generated by `make env`.

# ---- secrets (generated) -----------------------------------------------------------------
POSTGRES_PASSWORD=
KC_ADMIN_PASSWORD=
DEMO_USER_PASSWORD=
KC_PANEL_SECRET=
PANEL_AUTH_SECRET=
KC_LIBRECHAT_SECRET=
KC_AGENT_RESEARCH_BOT_SECRET=
LIBRECHAT_APP_SECRET=
ACL_VALUE_HASH_SALT=
ACL_API_KEY_PEPPER=
FEED_ADMIN_TOKEN=

# ---- cloud connector (Gemini, OpenAI-compatible endpoint) ----------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_PRO_MODEL=gemini-pro-latest

# ---- local model server (vLLM / SGLang / Ollama), OpenAI-compatible base URL ------------------
# e.g. http://gpu-box:8000/v1 (vLLM/SGLang) or http://gpu-box:11434/v1 (Ollama).
# WCSS (scripts/wcss.py tunnel): http://host.docker.internal:8001/v1, models: qwen3.8-27b
LOCAL_LLM_BASE_URL=
LOCAL_LLM_API_KEY=
# Qwen3.8-27B serves all local chat (confidential work) and the L2 judge; set both to its server tag.
LOCAL_GENERAL_MODEL=
# Bielik (local Polish-language specialist, alias `bielik`; `auto` sends Polish legal texts here) runs on its own vLLM
# server (connector `local-pl`). Optional: when either value is empty the model is unavailable and requests for it
# fall back to the local Qwen. The API key is shared with LOCAL_LLM_API_KEY.
# e.g. http://host.docker.internal:8002/v1 (a second vLLM server on its own port)
LOCAL_PL_BASE_URL=
LOCAL_BIELIK_MODEL=
LOCAL_EMBED_MODEL=
LOCAL_JUDGE_MODEL=

# ---- gateway ---------------------------------------------------------------------------------
# 1 = all connectors replaced by the deterministic mock (tests, offline demo)
ACL_DETERMINISTIC=0
ACL_LOG_LEVEL=INFO
GATEWAY_PORT=8000
KEYCLOAK_PORT=8180
FEED_PORT=8090
SINK_PORT=8099
# optional: hex ed25519 seed for signed feed bundles (then set signatures.feed.verify: ed25519 + public_key)
FEED_SIGNING_KEY=
